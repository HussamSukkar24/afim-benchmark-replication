# Secrets and local environment files
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Notebook files
# The repository keeps the corresponding .py versions instead
.ipynb_checkpoints/
*.ipynb

# Python tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and package artefacts
build/
dist/
*.egg-info/

# Intermediate CSV exports
# Final analysis outputs are stored in JSON
*.csv

# Logs and temporary files
*.log
*.tmp
*.temp
~$*

# IDE/editor settings
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db
